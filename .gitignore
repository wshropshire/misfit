# macOS metadata
.DS_Store

# Python cache
__pycache__/
*.py[cod]

# Virtual environments
.env/
.venv/
*.env

# Build artifacts (root only: src/misfit/build holds the conda env spec)
/build/
/dist/
*.egg-info/

# Editors / local tooling
.vscode/
.idea/
.claude/settings.local.json

# Geneious collection folders, created by opening a reference FASTA in Geneious.
# They sit beside the real ref_<gene>.fasta as a directory of the same stem.
src/misfit/reference/*/ref_*/
*.clxn
.collection
